# Research Scholar Agent - Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API Key (optional but recommended for AI summaries)
# Get your key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Flask Secret Key (for session management)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=research-scholar-secret-key-12345

# Flask Environment
FLASK_ENV=development

# Debug Mode (set to False in production)
FLASK_DEBUG=True
